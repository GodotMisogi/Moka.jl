@article{dos_santos_viscous_2021,
	title = {Viscous extension of vortex methods for unsteady aerodynamics},
	volume = {33},
	issn = {1070-6631, 1089-7666},
	url = {https://pubs.aip.org/pof/article/33/10/103606/1065006/Viscous-extension-of-vortex-methods-for-unsteady},
	doi = {10.1063/5.0065293},
	abstract = {The Kutta condition has been extensively used to determine aerodynamic loads of steady and unsteady ﬂows over airfoils. Nevertheless, the application of this condition to unsteady ﬂows has been controversial for decades. A viscous correction to the Kutta condition was recently developed by matching the potential ﬂow solution with a special boundary layer theory that resolves the ﬂow ﬁeld in the immediate vicinity of the trailing edge: the triple-deck boundary layer theory. In this work, we utilize this viscous condition to extend two common numerical methods for unsteady aerodynamics to capture viscous effects on the dynamics of unsteady lift and pitching moment—we develop viscous versions of the traditional discrete vortex method and unsteady vortex lattice/panel method. The resulting aerodynamic loads obtained from the proposed numerical models are compared against higher-ﬁdelity simulations of unsteady Reynolds-averaged Navier–Stokes equations for an airfoil undergoing step, harmonic, and complex maneuvers. The obtained results are consistently in better agreement with the unsteady Reynolds-averaged Navier–Stokes simulations in comparison to their potential ﬂow counterpart. In conclusion, the developed numerical methods are capable of capturing (i) unsteady effects; (ii) viscous effects (e.g., viscosity-induced lag) on the dynamics of lift and moment at high frequencies and low Reynolds numbers; and (iii) wake deformation, for arbitrary time-varying motion.},
	language = {en},
	number = {10},
	urldate = {2023-12-20},
	journal = {Physics of Fluids},
	author = {Dos Santos, C. R. and Rezaei, A. S. and Taha, H. E.},
	month = oct,
	year = {2021},
	pages = {103606},
}

@book{moukalled_finite_2016,
